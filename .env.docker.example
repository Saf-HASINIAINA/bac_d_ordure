# Copier ce fichier en .env.docker (ignoré par git) et choisir des valeurs. Ne jamais mettre de vrai secret ici.
# Mot de passe de la base PostgreSQL locale du docker-compose (obligatoire)
POSTGRES_PASSWORD=
# Mot de passe des comptes de démo admin@ / superviseur@ / chauffeur@tulear.mg (8 à 72 caractères ; vide = généré et affiché dans les logs)
DEMO_PASSWORD=
# Port de l'application sur votre machine (8080 par défaut)
APP_PORT=8080
