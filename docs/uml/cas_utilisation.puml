@startuml cas_utilisation
title Cas d'utilisation - Gestion automatique du ramassage (Tuléar)
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

actor "Visiteur" as Vis
actor "Administrateur" as Admin
actor "Superviseur" as Sup
actor "Chauffeur" as Chauf
actor "Simulateur\n(capteurs, GPS)" as Sim <<système>>
Admin -|> Sup
Sup -|> Chauf

rectangle "Système de gestion du ramassage" {
  package "Accès" {
    usecase "S'inscrire\n(compte chauffeur en attente)" as UC_ins
    usecase "Se connecter / se déconnecter" as UC_con
  }
  package "Parc (administrateur)" {
    usecase "Installer, modifier, retirer\nun bac" as UC_bac
    usecase "Gérer les zones" as UC_zone
    usecase "Gérer les camions" as UC_cam
  }
  package "Comptes (administrateur)" {
    usecase "Valider ou désactiver un compte" as UC_val
    usecase "Créer un compte avec un rôle" as UC_cre
  }
  package "Supervision" {
    usecase "Visualiser la carte des bacs\net des camions" as UC_carte
    usecase "Consulter les indicateurs\net les alertes" as UC_alertes
    usecase "Traiter une alerte" as UC_traiter
    usecase "Planifier une tournée" as UC_plan
    usecase "Annuler une tournée" as UC_ann
    usecase "Mettre un bac ou un camion\nhors service / en service" as UC_maint
    usecase "Consulter les rapports\net exporter en CSV" as UC_rapport
  }
  package "Collecte" {
    usecase "Consulter ses tournées" as UC_mes
    usecase "Démarrer une tournée" as UC_dem
    usecase "Confirmer la vidange d'un bac" as UC_vid
    usecase "Terminer une tournée" as UC_ter
    usecase "Signaler un incident" as UC_inc
    usecase "Changer son mot de passe" as UC_mdp
  }
  package "Automatique" {
    usecase "Envoyer les mesures\ndes capteurs" as UC_mesures
    usecase "Générer une alerte\n(bac plein, incendie)" as UC_gen
    usecase "Détecter un capteur muet\n(RG6)" as UC_panne
    usecase "Calculer l'ordre de passage\n(Strategy)" as UC_ordre
  }
}

Vis --> UC_ins
Vis --> UC_con
Admin --> UC_bac
Admin --> UC_zone
Admin --> UC_cam
Admin --> UC_val
Admin --> UC_cre
Sup --> UC_carte
Sup --> UC_alertes
Sup --> UC_traiter
Sup --> UC_plan
Sup --> UC_ann
Sup --> UC_maint
Sup --> UC_rapport
Chauf --> UC_mes
Chauf --> UC_dem
Chauf --> UC_vid
Chauf --> UC_ter
Chauf --> UC_inc
Chauf --> UC_mdp
Chauf --> UC_carte
Sim --> UC_mesures

UC_val ..> UC_con : <<include>>
UC_plan ..> UC_ordre : <<include>>
UC_mesures ..> UC_gen : <<extend>>\n[niveau >= 80 % ou gaz élevé]
UC_mesures ..> UC_panne : <<extend>>\n[plus de mesure depuis N min]
note right of UC_ins
  Le compte reste inactif tant
  qu'un administrateur ne l'a pas validé.
end note
note right of UC_vid
  La vidange clôture automatiquement
  l'alerte BAC_PLEIN du bac.
end note
note bottom of UC_mes
  Un chauffeur ne voit et ne manipule
  que les tournées qui lui sont confiées.
end note
note right of UC_bac
  Un bac a 3 capteurs créés avec lui.
  Supprimable seulement s'il n'a jamais été
  collecté, sinon : hors service.
end note
@enduml
